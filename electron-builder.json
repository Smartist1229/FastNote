{
  "productName": "FastNote",
  "appId": "com.smartist.fastnote",
  "asar": true,
  "directories": {
    "output": "release"
  },
  "afterPack": "./build/hooks/afterPack.js",
  "files": ["dist/**/*", "package.json", "electron/**/*"],
  "mac": {
    "target": [
      "dmg",
      "pkg"
    ],
    "icon": "build/icon.icns",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "category": "public.app-category.productivity"
  },
  "linux": {
    "target": ["AppImage", "deb", "rpm"],
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "category": "Utility"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["ia32", "x64", "arm64"]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "guid": "com.smartist.fastnote",
    "include": "build/installer.nsh"
  }
}
