{
  "name": "fastnote",
  "private": true,
  "version": "0.0.6",
  "author": "Smartist",
  "description": "快速编辑、保存、分类管理文字片段",
  "main": "./electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder --win --ia32",
    "preview": "vite preview",
    "electron:serve": "vite --host",
    "electron:build": "vite build && electron-builder --win --ia32",
    "build:win": "vite build && electron-builder --win --config=./electron-builder.json",
    "build:mac": "vite build && electron-builder --mac --config=./electron-builder.json",
    "build:linux": "vite build && electron-builder --linux --config=./electron-builder.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.2.1",
    "mitt": "^3.0.1",
    "moment": "^2.30.1",
    "monaco-editor": "^0.51.0",
    "nanoid": "^5.0.7",
    "vue": "^3.4.31",
    "vue3-toastify": "^0.2.2"
  },
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "@types/file-saver": "^2.0.7",
    "@types/vue": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "electron": "^32.0.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.6.2",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.7"
  }
}
